<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TwinCAT.ProductivityTools</id>
    <version>0.0.0</version>
    <title>TwinCAT Productivity Tools</title>
    <authors>Philipp Leidig</authors>
    <projectUrl>https://github.com/philippleidig/TwinCAT.ProductivityTools</projectUrl>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>icon.png</icon>
    <tags>TwinCAT Workload VariantXAE CategoryTools</tags>
    <summary>Productivity commands for TwinCAT XAE.</summary>
    <description>Installs the TwinCAT Productivity Tools into every supported engineering environment on this machine and deploys the optimized PLC project template. The extension adds commands for PLC housekeeping, target system maintenance, I/O mapping export and project freezing to TwinCAT XAE.</description>
    <packageTypes>
      <packageType name="Workload" />
    </packageTypes>
    <!--
      The per IDE integration packages are listed here and not on TwinCAT.ProductivityTools.XAE.
      TcPkg reads an id that ends in the name of an engineering environment as the integration of
      the package that remains when that suffix is removed, and adds the edge
      TwinCAT.ProductivityTools.XAE.TcXaeShell => TwinCAT.ProductivityTools.XAE by itself. A
      dependency in the other direction would close that loop, which is what made
      "tcpkg install TwinCAT.ProductivityTools" fail with a circular dependency up to 1.1.11.
    -->
    <dependencies>
      <dependency id="TwinCAT.ProductivityTools.Config" version="[0.0.0,)" />
      <dependency id="TwinCAT.ProductivityTools.XAE" version="[0.0.0,)" />
      <dependency id="TwinCAT.ProductivityTools.XAE.TcXaeShell" version="[0.0.0,)" />
      <dependency id="TwinCAT.ProductivityTools.XAE.TcXaeShell64" version="[0.0.0,)" />
      <dependency id="TwinCAT.ProductivityTools.XAE.VS2022" version="[0.0.0,)" />
      <dependency id="TwinCAT.ProductivityTools.XAE.VS2026" version="[0.0.0,)" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\_shared\icon.png" target="icon.png" />
    <file src="tools\**" target="tools" />
  </files>
</package>