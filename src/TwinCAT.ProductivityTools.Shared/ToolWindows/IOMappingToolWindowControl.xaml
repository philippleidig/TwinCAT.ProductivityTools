<UserControl
    x:Class="TwinCAT.ProductivityTools.ToolWindows.IOMappingToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TwinCAT.ProductivityTools.ToolWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    toolkit:Themes.UseVsTheme="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,4"
            HorizontalAlignment="Left"
            Orientation="Horizontal">

            <TextBox
                Width="240"
                Height="22"
                VerticalContentAlignment="Center"
                ToolTip="Filters the tree by variable or path."
                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

            <Button
                Margin="4,0,0,0"
                Padding="8,0"
                Command="{Binding ReloadCommand}"
                Content="Reload"
                ToolTip="Reads the mapping information of the active configuration again." />

            <Button
                Margin="4,0,0,0"
                Padding="8,0"
                Command="{Binding ExportCommand}"
                Content="Export to CSV"
                ToolTip="Writes all mappings to a comma separated file." />
        </StackPanel>

        <TreeView
            x:Name="MappingTree"
            Grid.Row="1"
            ItemsSource="{Binding FilteredTreeData}">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding CopyCommand}"
                        CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        Header="Copy" />
                    <MenuItem Command="{Binding ExportCommand}" Header="Export all to CSV" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Margin="5,0" Text="{Binding Name}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock
            Grid.Row="2"
            Margin="2,4,0,0"
            Opacity="0.8"
            Text="{Binding Status}" />
    </Grid>
</UserControl>
