<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TwinCAT.ProductivityTools.XAE</id>
    <version>0.0.0</version>
    <title>TwinCAT Productivity Tools - XAE base</title>
    <authors>Philipp Leidig</authors>
    <projectUrl>https://github.com/philippleidig/TwinCAT.ProductivityTools</projectUrl>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>icon.png</icon>
    <tags>TwinCAT TCXAESHELL TCXAESHELL64 VS2022 VS2026</tags>
    <summary>Base package of the engineering integration.</summary>
    <description>Base package of the TwinCAT Productivity Tools integration for the engineering environments. It holds no payload. TcPkg links every TwinCAT.ProductivityTools.XAE.&lt;environment&gt; package to this one automatically, so the per environment packages must not be listed as dependencies here - that would form a circular dependency. The workload TwinCAT.ProductivityTools pulls them in instead.</description>
    <!--
      Must stay free of any TwinCAT.ProductivityTools.XAE.* dependency. TcPkg derives the edge
      TwinCAT.ProductivityTools.XAE.<environment> => TwinCAT.ProductivityTools.XAE from the package
      id alone, so a dependency in the other direction is a cycle. See the workload nuspec.
    -->
    <dependencies>
      <dependency id="TwinCAT.XAE.Base" version="0.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\_shared\icon.png" target="icon.png" />
    <file src="tools\**" target="tools" />
  </files>
</package>