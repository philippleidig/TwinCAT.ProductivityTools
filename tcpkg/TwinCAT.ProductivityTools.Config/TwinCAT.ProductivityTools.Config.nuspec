<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TwinCAT.ProductivityTools.Config</id>
    <version>0.0.0</version>
    <title>TwinCAT Productivity Tools - PLC project template</title>
    <authors>Philipp Leidig</authors>
    <projectUrl>https://github.com/philippleidig/TwinCAT.ProductivityTools</projectUrl>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>icon.png</icon>
    <tags>TwinCAT CategoryTools</tags>
    <summary>Deploys the "Standard PLC Project Optimized Defaults" template.</summary>
    <description>Deploys the "Standard PLC Project Optimized Defaults" PLC project template into the template directory of the installed TwinCAT version. TwinCAT 4024 and 4026 use different directories and different template layouts, so the matching layout is selected at install time.</description>
    <dependencies />
  </metadata>
  <files>
    <file src="..\_shared\icon.png" target="icon.png" />
    <file src="tools\**" target="tools" />
    <file src="..\..\templates\**" target="tools\templates" />
  </files>
</package>