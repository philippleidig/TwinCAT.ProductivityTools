<UserControl
    x:Class="TwinCAT.ProductivityTools.ToolWindows.IOMappingToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:controls="clr-namespace:TwinCAT.ProductivityTools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:local="clr-namespace:TwinCAT.ProductivityTools.ToolWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    toolkit:Themes.UseVsTheme="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Height="24px"
            HorizontalAlignment="Left"
            Orientation="Horizontal">

            <TextBox
                Width="200"
                HorizontalAlignment="Right"
                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

            <Button Command="{Binding ReloadCommand}" Content="Reload" />

            <!-- <Button Content="Collapse All" Command="{Binding CollapseAllCommand}" Margin="10,0,0,0"/> -->
        </StackPanel>

        <TreeView Grid.Row="1" ItemsSource="{Binding FilteredTreeData}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="5,0" Text="{Binding Name}" />

                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding DataContext.GoToDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}" Header="Go To Destination" />
                                <MenuItem Command="{Binding DataContext.GoToSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" Header="Go To Source" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="SelectedItemChanged">
                    <behaviors:InvokeCommandAction Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                </behaviors:EventTrigger>
                <behaviors:EventTrigger EventName="MouseDoubleClick">
                    <behaviors:InvokeCommandAction Command="{Binding DataContext.DoubleClickCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
        </TreeView>

    </Grid>
</UserControl>
